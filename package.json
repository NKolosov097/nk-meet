{
  "name": "nk-meet-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "start": "pnpm --dir frontend start",
    "android": "pnpm --dir frontend android",
    "ios": "pnpm --dir frontend ios",
    "web": "pnpm --dir frontend web",
    "build:ios": "pnpm --dir frontend build:ios",
    "build:ios:production": "pnpm --dir frontend build:ios:production",
    "build:android": "pnpm --dir frontend build:android",
    "prebuild": "pnpm --dir frontend prebuild",
    "prebuild:ios": "pnpm --dir frontend prebuild:ios",
    "test": "pnpm --dir frontend test",
    "test:node": "pnpm --dir frontend test:node && pnpm --dir backend test",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "pnpm -r --if-present type-check",
    "dev:backend": "pnpm --dir backend dev",
    "build:backend": "pnpm --dir backend build",
    "test:backend": "pnpm --dir backend test"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
