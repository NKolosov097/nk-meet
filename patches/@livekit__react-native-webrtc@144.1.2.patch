@@ -69,3 +95,2 @@
-        [self.inputStream open];
-        [self.outputStream open];
-    });
+            [connection.networkThread start];
+            [connection performSelector:@selector(scheduleStreams) onThread:connection.networkThread withObject:nil waitUntilDone:true];
@@ -73,2 +98,7 @@
